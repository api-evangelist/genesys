                "value": "",
                "type": "path",
                "description": "Message ID"
              }
            ]
          },
          "docs": "A user voicemail can only be deleted by its associated user. A group voicemail can only be deleted by a user that is a member of the group. A queue voicemail can only be deleted by a user with the acd voicemail delete permission."
        },
