        },
        {
          "info": {
            "name": "Delete a voicemail message.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v2/voicemail/messages/:messageId",
            "params": [
              {
